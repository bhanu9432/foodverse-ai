# Copy to .env and fill in.
ANTHROPIC_API_KEY=
# Model used for vision and reasoning.
FOODVERSE_MODEL=claude-sonnet-5-5
# SQLite file for scan history and your profile.
FOODVERSE_DB=foodverse.db
# Whisper model size for optional server-side speech-to-text: tiny, base, small
WHISPER_MODEL=tiny
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
